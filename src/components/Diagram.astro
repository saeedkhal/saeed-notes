---
/**
 * رسمة canvas: صناديق (nodes) وأسهم (edges) عليها كلام، ونقط بتمشي على السهم
 * عشان توضّح مين بيبعت لمين.
 *
 * x و y نسبة مئوية من عرض وطول الرسمة. mx و my نفس الكلام للموبايل (أقل من 560px).
 * bend بيقوّس السهم (بالبيكسل، موجب أو سالب) عشان سهمين رايح وجاي ميركبوش على بعض.
 */
export interface DiagramNode {
  id: string;
  t: string;
  s?: string;
  c?: 1 | 2 | 3 | 4 | 5;
  x: number;
  y: number;
  mx?: number;
  my?: number;
}
export interface DiagramEdge {
  from: string;
  to: string;
  t?: string;
  c?: 1 | 2 | 3 | 4 | 5;
  dash?: boolean;
  bend?: number;
  mbend?: number;
}
interface Props {
  title?: string;
  nodes: DiagramNode[];
  edges: DiagramEdge[];
  height?: number;
  mheight?: number;
}
const { title, nodes, edges, height = 300, mheight = 420 } = Astro.props;
const name = (id: string) => nodes.find((n) => n.id === id)?.t ?? id;
const data = JSON.stringify({ nodes, edges, height, mheight });
---
<figure class="diagram">
  {title && <figcaption>{title}</figcaption>}
  <canvas data-diagram={data} role="img" aria-label={title ?? "رسمة"} style={`height:${height}px`}></canvas>
  <ol class="diagram-steps">
    {edges.map((e) => (
      <li>{name(e.from)} ← {name(e.to)}{e.t ? `: ${e.t}` : ""}</li>
    ))}
  </ol>
</figure>

<style>
  .diagram {
    margin: 1.6em 0;
    background: var(--bg-soft);
    border-radius: 16px;
    padding: 14px 12px 10px;
  }
  .diagram figcaption {
    font-weight: 800;
    color: var(--heading);
    margin: 0 4px 6px;
    font-size: 0.98rem;
  }
  .diagram canvas {
    display: block;
    width: 100%;
  }
  /* نسخة نصية لقارئ الشاشة ولو الـ JS مش شغال */
  .diagram-steps {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>

<script>
  type Node = { id: string; t: string; s?: string; c?: number; x: number; y: number; mx?: number; my?: number };
  type Edge = { from: string; to: string; t?: string; c?: number; dash?: boolean; bend?: number; mbend?: number };
  type Data = { nodes: Node[]; edges: Edge[]; height: number; mheight: number };
  type Box = { x: number; y: number; w: number; h: number; node: Node };
  type Pt = { x: number; y: number };

  const NARROW = 560;
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");

  /** النص اللي بيبدأ بحرف لاتيني يتكتب LTR عشان الأقواس والنقط متتقلبش */
  const dirOf = (s: string) => (/^[^\p{L}]*[A-Za-z]/u.test(s) ? "ltr" : "rtl");

  const quad = (a: Pt, c: Pt, b: Pt, t: number): Pt => ({
    x: (1 - t) ** 2 * a.x + 2 * (1 - t) * t * c.x + t ** 2 * b.x,
    y: (1 - t) ** 2 * a.y + 2 * (1 - t) * t * c.y + t ** 2 * b.y,
  });

  /** نقطة خروج الشعاع من مركز الصندوق باتجاه target على حدود الصندوق */
  function edgeOf(box: Box, target: Pt, pad = 6): Pt {
    const dx = target.x - box.x;
    const dy = target.y - box.y;
    if (dx === 0 && dy === 0) return { x: box.x, y: box.y };
    const sx = (box.w / 2 + pad) / Math.abs(dx || 1e-9);
    const sy = (box.h / 2 + pad) / Math.abs(dy || 1e-9);
    const s = Math.min(sx, sy);
    return { x: box.x + dx * s, y: box.y + dy * s };
  }

  function roundRect(ctx: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, r: number) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.arcTo(x + w, y, x + w, y + h, r);
    ctx.arcTo(x + w, y + h, x, y + h, r);
    ctx.arcTo(x, y + h, x, y, r);
    ctx.arcTo(x, y, x + w, y, r);
    ctx.closePath();
  }

  function boot(canvas: HTMLCanvasElement) {
    const data: Data = JSON.parse(canvas.dataset.diagram!);
    const ctx = canvas.getContext("2d")!;
    let visible = false;
    let raf = 0;
    const start = performance.now();

    const draw = (now: number) => {
      const css = getComputedStyle(canvas);
      const v = (name: string) => css.getPropertyValue(name).trim();
      const color = (c?: number) => v(`--c${c ?? 1}`) || "#6c4bff";
      const font = getComputedStyle(document.body).fontFamily;

      const W = canvas.clientWidth;
      const narrow = W < NARROW;
      const H = narrow ? data.mheight : data.height;
      if (canvas.style.height !== `${H}px`) canvas.style.height = `${H}px`;
      const dpr = window.devicePixelRatio || 1;
      if (canvas.width !== Math.round(W * dpr) || canvas.height !== Math.round(H * dpr)) {
        canvas.width = Math.round(W * dpr);
        canvas.height = Math.round(H * dpr);
      }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, W, H);
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";

      const tSize = narrow ? 13.5 : 15;
      const sSize = narrow ? 11 : 12;

      // الصناديق: نقيس الكلام الأول عشان نعرف المقاس
      const boxes = new Map<string, Box>();
      for (const n of data.nodes) {
        ctx.font = `800 ${tSize}px ${font}`;
        let w = ctx.measureText(n.t).width;
        if (n.s) {
          ctx.font = `600 ${sSize}px ${font}`;
          w = Math.max(w, ctx.measureText(n.s).width);
        }
        w += 28;
        const h = n.s ? 52 : 38;
        const px = ((narrow ? n.mx ?? n.x : n.x) / 100) * W;
        const py = ((narrow ? n.my ?? n.y : n.y) / 100) * H;
        const x = Math.min(Math.max(px, w / 2 + 2), W - w / 2 - 2);
        const y = Math.min(Math.max(py, h / 2 + 2), H - h / 2 - 2);
        boxes.set(n.id, { x, y, w, h, node: n });
      }

      // الأسهم الأول عشان الصناديق تبقى فوقها
      const labels: { at: Pt; text: string; c: string }[] = [];
      data.edges.forEach((e, i) => {
        const a = boxes.get(e.from);
        const b = boxes.get(e.to);
        if (!a || !b) return;
        const bend = narrow ? e.mbend ?? e.bend ?? 0 : e.bend ?? 0;
        const mid = { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 };
        const len = Math.hypot(b.x - a.x, b.y - a.y) || 1;
        // RTL: الـ bend الموجب يقوّس لفوق في الحالتين
        const nx = -(b.y - a.y) / len;
        const ny = (b.x - a.x) / len;
        const ctrl = { x: mid.x + nx * bend, y: mid.y + ny * bend };
        const p0 = edgeOf(a, bend ? ctrl : b);
        const p2 = edgeOf(b, bend ? ctrl : a, 9);
        const c = color(e.c);

        ctx.strokeStyle = c;
        ctx.lineWidth = 2.2;
        ctx.setLineDash(e.dash ? [7, 6] : []);
        ctx.beginPath();
        ctx.moveTo(p0.x, p0.y);
        ctx.quadraticCurveTo(ctrl.x, ctrl.y, p2.x, p2.y);
        ctx.stroke();
        ctx.setLineDash([]);

        // راس السهم في اتجاه آخر جزء من المنحنى
        const ang = Math.atan2(p2.y - ctrl.y, p2.x - ctrl.x);
        ctx.fillStyle = c;
        ctx.beginPath();
        ctx.moveTo(p2.x + Math.cos(ang) * 4, p2.y + Math.sin(ang) * 4);
        ctx.lineTo(p2.x - Math.cos(ang - 0.45) * 12, p2.y - Math.sin(ang - 0.45) * 12);
        ctx.lineTo(p2.x - Math.cos(ang + 0.45) * 12, p2.y - Math.sin(ang + 0.45) * 12);
        ctx.closePath();
        ctx.fill();

        // النقطة اللي بتمشي على السهم = "الريكوست" وهو رايح
        if (!reduceMotion.matches) {
          const t = ((now - start) / 2200 + i * 0.37) % 1;
          const dot = quad(p0, ctrl, p2, t);
          ctx.globalAlpha = t < 0.1 ? t * 10 : t > 0.85 ? (1 - t) / 0.15 : 1;
          ctx.beginPath();
          ctx.arc(dot.x, dot.y, 4.5, 0, Math.PI * 2);
          ctx.fill();
          ctx.globalAlpha = 1;
        }

        // سهم ليه سهم راجع: كل كلام يتزق ناحية بداية سهمه عشان الاتنين ميركبوش على بعض
        const paired = data.edges.some((o) => o.from === e.to && o.to === e.from);
        if (e.t) {
          const at = quad(p0, ctrl, p2, paired ? 0.32 : 0.5);
          // وكمان يتزق لبره ناحية التقويسة بتاعته
          const push = paired && bend ? Math.sign(bend) * 13 : 0;
          labels.push({ at: { x: at.x + nx * push, y: at.y + ny * push }, text: e.t, c });
        }
      });

      for (const box of boxes.values()) {
        const c = color(box.node.c);
        roundRect(ctx, box.x - box.w / 2, box.y - box.h / 2, box.w, box.h, 12);
        ctx.fillStyle = v("--bg") || "#fff";
        ctx.fill();
        ctx.fillStyle = c;
        ctx.globalAlpha = 0.1;
        ctx.fill();
        ctx.globalAlpha = 1;
        ctx.lineWidth = 2;
        ctx.strokeStyle = c;
        ctx.stroke();

        const ty = box.node.s ? box.y - 9 : box.y + 1;
        ctx.direction = dirOf(box.node.t);
        ctx.font = `800 ${tSize}px ${font}`;
        ctx.fillStyle = c;
        ctx.fillText(box.node.t, box.x, ty);
        if (box.node.s) {
          ctx.direction = dirOf(box.node.s);
          ctx.font = `600 ${sSize}px ${font}`;
          ctx.fillStyle = v("--muted") || "#777";
          ctx.fillText(box.node.s, box.x, box.y + 12);
        }
      }

      // الكلام فوق الأسهم في الآخر عشان محدش يغطيه
      const lSize = narrow ? 11.5 : 12.5;
      ctx.font = `700 ${lSize}px ${font}`;
      const h = lSize + 11;
      const rects = labels.map((l) => {
        ctx.direction = dirOf(l.text);
        const w = ctx.measureText(l.text).width + 16;
        return { ...l, w, x: Math.min(Math.max(l.at.x, w / 2 + 1), W - w / 2 - 1), y: l.at.y };
      });
      // لو كلامين ركبوا على بعض، نبعّدهم عن بعض لفوق وتحت لحد ما يفصلوا
      for (let round = 0; round < 12; round++) {
        let moved = false;
        for (let i = 0; i < rects.length; i++) {
          for (let j = i + 1; j < rects.length; j++) {
            const a = rects[i]!;
            const b = rects[j]!;
            const ox = (a.w + b.w) / 2 + 4 - Math.abs(a.x - b.x);
            const oy = h + 4 - Math.abs(a.y - b.y);
            if (ox <= 0 || oy <= 0) continue;
            const dir = a.y <= b.y ? -1 : 1;
            a.y += (dir * oy) / 2;
            b.y -= (dir * oy) / 2;
            moved = true;
          }
        }
        if (!moved) break;
      }
      for (const l of rects) {
        ctx.direction = dirOf(l.text);
        const { w, x } = l;
        l.at = { x, y: Math.min(Math.max(l.y, h / 2 + 1), H - h / 2 - 1) };
        roundRect(ctx, x - w / 2, l.at.y - h / 2, w, h, h / 2);
        ctx.fillStyle = v("--bg") || "#fff";
        ctx.fill();
        ctx.lineWidth = 1.5;
        ctx.strokeStyle = l.c;
        ctx.stroke();
        ctx.fillStyle = l.c;
        ctx.fillText(l.text, x, l.at.y + 1);
      }
    };

    const loop = (now: number) => {
      raf = 0;
      if (!canvas.isConnected) return;
      draw(now);
      if (visible && !reduceMotion.matches) raf = requestAnimationFrame(loop);
    };
    const kick = () => {
      if (!raf) raf = requestAnimationFrame(loop);
    };

    new IntersectionObserver(([entry]) => {
      visible = !!entry?.isIntersecting;
      if (visible) kick();
    }).observe(canvas);
    new ResizeObserver(kick).observe(canvas);
    new MutationObserver(kick).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
    matchMedia("(prefers-color-scheme: dark)").addEventListener("change", kick);
    document.fonts?.ready.then(kick);
    kick();
  }

  const bootAll = () => {
    for (const c of document.querySelectorAll<HTMLCanvasElement>("canvas[data-diagram]")) {
      if (c.dataset.bound) continue;
      c.dataset.bound = "1";
      boot(c);
    }
  };
  bootAll();
  document.addEventListener("astro:page-load", bootAll);
</script>
