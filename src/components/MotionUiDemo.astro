---
/**
 * ديموهات حية لأفكار Motion UI، معمولة من الصفر بـ TypeScript عادي (من غير motion-plus):
 * ticker، رقم بيتقلّب، scramble، typewriter، تقطيع النص، cursor، curtains.
 * الكود هنا تنفيذي أنا للفكرة، مش كود Motion+.
 * الـ CSS global بـ prefix ‎.mu-‎ عشان العناصر اللي الـ JS بيبنيها تاخد الشكل.
 */
type Kind = "ticker" | "number" | "scramble" | "typewriter" | "split" | "cursor" | "curtains";
interface Props {
  kind: Kind;
  title?: string;
}
const { kind, title } = Astro.props;
const hints: Record<Kind, string> = {
  ticker: "عدّي بالماوس عشان يهدى، وغيّر السرعة (السالب بيعكس الاتجاه)",
  number: "زوّد ونقّص وغيّر اللغة، وشوف كل رقم بيتقلّب لوحده",
  scramble: "دوس عشان النص يتفك ويتركب على الجملة اللي بعدها",
  typewriter: "بيكتب ويمسح لوحده، ويقف شوية عند العلامات",
  split: "اختار طريقة التقطيع ودوس إعادة",
  cursor: "حرّك الماوس جوه المربع، وعدّي على الزراير والنص (ماوس بس، مش لمس)",
  curtains: "اختار نوع الستارة وبدّل بين الشاشتين",
};
const tickerItems = ["React", "Vue", "Svelte", "Astro", "Solid", "Qwik", "Angular", "Lit"];
---
<figure class="mu" data-mu={kind}>
  {title && <figcaption>{title}<span>{hints[kind]}</span></figcaption>}
  <div class="mu-stage">
    {kind === "ticker" && (
      <>
        <div class="mu-ticker" data-ticker={JSON.stringify(tickerItems)} dir="ltr">
          <div class="mu-track"></div>
        </div>
        <div class="mu-ctrl" dir="rtl">
          <label>السرعة <input type="range" min="-200" max="200" step="10" value="60" data-velocity /> <output>60</output> px/s</label>
          <label class="mu-check"><input type="checkbox" data-show-clones /> لوّن النسخ</label>
        </div>
        <p class="mu-note" data-ticker-info></p>
      </>
    )}

    {kind === "number" && (
      <>
        <div class="mu-number-wrap">
          <span class="mu-number" data-number aria-live="polite"></span>
        </div>
        <div class="mu-ctrl" dir="rtl">
          <button type="button" class="mu-btn" data-step="-137">−137</button>
          <button type="button" class="mu-btn" data-step="1">+1</button>
          <button type="button" class="mu-btn" data-step="1250">+1250</button>
          <button type="button" class="mu-btn" data-random>رقم عشوائي</button>
          <button type="button" class="mu-btn" data-locale>اللغة: en-US</button>
        </div>
      </>
    )}

    {kind === "scramble" && (
      <>
        <p class="mu-scramble" data-scramble dir="ltr">Motion makes it feel alive</p>
        <div class="mu-ctrl"><button type="button" class="mu-btn" data-next>الجملة اللي بعدها</button></div>
      </>
    )}

    {kind === "typewriter" && (
      <p class="mu-type"><span data-type></span><span class="mu-caret" aria-hidden="true"></span></p>
    )}

    {kind === "split" && (
      <>
        <p class="mu-split" data-split></p>
        <div class="mu-ctrl" dir="rtl">
          <button type="button" class="mu-btn" data-mode="en-chars" aria-pressed="true">حروف إنجليزي</button>
          <button type="button" class="mu-btn" data-mode="ar-chars" aria-pressed="false">حروف عربي</button>
          <button type="button" class="mu-btn" data-mode="ar-words" aria-pressed="false">كلمات عربي</button>
          <button type="button" class="mu-btn" data-replay>إعادة</button>
        </div>
        <p class="mu-note" data-split-note></p>
      </>
    )}

    {kind === "cursor" && (
      <div class="mu-cursor-area" data-cursor-area>
        <div class="mu-row">
          <button type="button" class="mu-btn" data-magnet>زرار ممغنط</button>
          <button type="button" class="mu-btn" data-magnet>وزرار تاني</button>
        </div>
        <p class="mu-cursor-text">نص عادي، الـ cursor بيبقى خط رفيع زي ما يكون هتكتب.</p>
        <span class="mu-dot" aria-hidden="true"></span>
      </div>
    )}

    {kind === "curtains" && (
      <>
        <div class="mu-screens" data-screens>
          <div class="mu-screen mu-screen-a"><b>الشاشة ١</b><span>Home</span></div>
          <div class="mu-screen mu-screen-b" hidden><b>الشاشة ٢</b><span>Settings</span></div>
        </div>
        <div class="mu-ctrl" dir="rtl">
          <button type="button" class="mu-btn" data-curtain="wipe">wipe</button>
          <button type="button" class="mu-btn" data-curtain="iris">iris</button>
          <button type="button" class="mu-btn" data-curtain="blinds">blinds</button>
          <button type="button" class="mu-btn" data-curtain="pixels">pixels</button>
        </div>
      </>
    )}
  </div>
</figure>

<style is:global>
  .mu {
    --mu-back: cubic-bezier(0.34, 1.56, 0.64, 1);
    --mu-out: cubic-bezier(0.33, 1, 0.68, 1);
    --mu-in: cubic-bezier(0.32, 0, 0.67, 0);
    margin: 1.6em 0;
    background: var(--bg-soft);
    border-radius: 16px;
    padding: 14px 14px 16px;
  }
  .mu figcaption { font-weight: 800; color: var(--heading); margin: 0 4px 10px; font-size: 0.98rem; }
  .mu figcaption span { display: block; font-weight: 600; color: var(--muted); font-size: 0.82em; }
  .mu-stage {
    background: var(--bg-elev);
    border: 1.5px solid var(--line);
    border-radius: 14px;
    padding: 18px 14px;
    min-height: 90px;
    position: relative;
    overflow: hidden;
  }
  .mu-row { display: flex; gap: 10px; align-items: center; justify-content: center; flex-wrap: wrap; }
  .mu-ctrl {
    display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; justify-content: center;
    margin-top: 14px; font: 600 0.85rem var(--font); color: var(--text);
  }
  .mu-ctrl label { display: inline-flex; gap: 6px; align-items: center; }
  .mu-ctrl input[type="range"] { accent-color: var(--c2); width: 140px; max-width: 40vw; }
  .mu-ctrl output { font: 700 0.85rem var(--mono); color: var(--c2); min-width: 3ch; text-align: center; }
  .mu-check input { accent-color: var(--c2); }
  .mu-note { margin: 10px 0 0; text-align: center; font: 600 0.8rem var(--font); color: var(--muted); }
  .mu-btn {
    font: 700 0.85rem var(--font);
    color: var(--heading);
    background: var(--bg-soft);
    border: 1.5px solid var(--line);
    border-radius: 10px;
    padding: 6px 12px;
    cursor: pointer;
    transition: transform 0.22s var(--mu-back), border-color 0.15s, color 0.15s;
  }
  .mu-btn:active { transform: scale(0.95); }
  .mu-btn[aria-pressed="true"] { border-color: var(--c1); color: var(--c1); }

  /* ───── ticker ───── */
  .mu-ticker {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .mu-track { display: flex; width: max-content; will-change: transform; }
  .mu-tick {
    flex: none;
    margin-inline-end: 12px;
    padding: 8px 16px;
    border-radius: 99px;
    border: 1.5px solid var(--line);
    background: var(--bg-soft);
    font: 700 0.95rem var(--font);
    color: var(--heading);
  }
  .mu-show-clones .mu-tick[aria-hidden="true"] {
    border-style: dashed;
    border-color: var(--c3);
    color: var(--c3);
  }
  .mu-ticker.is-static { overflow-x: auto; mask-image: none; }

  /* ───── رقم ───── */
  .mu-number-wrap { display: flex; justify-content: center; }
  .mu-number {
    display: inline-flex;
    direction: ltr;
    font: 800 clamp(2rem, 9vw, 3.2rem) / 1 var(--mono);
    color: var(--heading);
    font-variant-numeric: tabular-nums;
  }
  .mu-col {
    display: inline-block;
    height: 1em;
    overflow: hidden;
    transition: width 0.3s var(--mu-out), opacity 0.2s;
  }
  .mu-col > span {
    display: flex;
    flex-direction: column;
    transition: transform 0.6s var(--mu-back);
  }
  .mu-col > span > i { font-style: normal; height: 1em; text-align: center; }
  .mu-sym { color: var(--c2); }
  .mu-col.is-new { animation: mu-pop 0.35s var(--mu-back); }
  @keyframes mu-pop { from { opacity: 0; transform: translateY(0.4em) scale(0.6); } }

  /* ───── scramble و typewriter ───── */
  .mu-scramble {
    margin: 6px 0 0; text-align: center;
    font: 800 clamp(1.1rem, 5vw, 1.6rem) var(--mono); color: var(--heading);
    min-height: 1.5em; overflow-wrap: anywhere;
  }
  .mu-scramble .mu-glyph { color: var(--c4); }
  .mu-type { margin: 8px 0; text-align: center; font: 800 clamp(1.1rem, 5vw, 1.5rem) var(--font); color: var(--heading); min-height: 1.6em; }
  .mu-caret {
    display: inline-block; width: 3px; height: 1.1em; margin-inline-start: 3px;
    vertical-align: -0.15em; background: var(--c1); border-radius: 2px;
    animation: mu-blink 1s steps(1) infinite;
  }
  .mu-caret.is-typing { animation: none; }
  @keyframes mu-blink { 50% { opacity: 0; } }

  /* ───── split ───── */
  .mu-split {
    margin: 6px 0 0; text-align: center; min-height: 1.6em;
    font: 800 clamp(1.2rem, 5.5vw, 1.8rem) var(--font); color: var(--heading);
  }
  .mu-piece {
    display: inline-block;
    white-space: pre;
    animation: mu-rise 0.5s var(--mu-back) both;
    animation-delay: calc(var(--i) * 28ms);
  }
  @keyframes mu-rise { from { opacity: 0; transform: translateY(0.6em) rotate(6deg); } }

  /* ───── cursor ───── */
  .mu-cursor-area { position: relative; padding: 18px 6px; min-height: 150px; display: grid; gap: 14px; align-content: center; }
  .mu-cursor-text { margin: 0; text-align: center; color: var(--text); font-weight: 600; }
  .mu-dot {
    position: absolute; left: 0; top: 0;
    width: 18px; height: 18px; border-radius: 99px;
    background: color-mix(in srgb, var(--c1) 35%, transparent);
    border: 2px solid var(--c1);
    pointer-events: none; opacity: 0;
    transition: opacity 0.15s, border-radius 0.15s;
  }
  .mu-dot.is-on { opacity: 1; }
  .mu-dot.is-text { border-radius: 2px; background: var(--c1); }
  @media (pointer: fine) {
    .mu-cursor-area.is-live, .mu-cursor-area.is-live * { cursor: none; }
  }

  /* ───── curtains ───── */
  .mu-screens { position: relative; height: 150px; border-radius: 12px; overflow: hidden; }
  .mu-screen {
    position: absolute; inset: 0; display: grid; place-content: center; gap: 4px; text-align: center;
    font: 800 1.4rem var(--font);
  }
  .mu-screen span { font: 700 0.9rem var(--mono); opacity: 0.8; }
  .mu-screen-a { background: color-mix(in srgb, var(--c1) 22%, var(--bg-soft)); color: var(--c1); }
  .mu-screen-b { background: color-mix(in srgb, var(--c5) 22%, var(--bg-soft)); color: var(--c5); }
  .mu-screen[hidden] { display: none; }
  .mu-cover { position: absolute; inset: 0; pointer-events: none; display: grid; }
  .mu-cover > i { display: block; background: var(--heading); }

  @media (prefers-reduced-motion: reduce) {
    .mu *, .mu *::before, .mu *::after {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-delay: 0s !important;
    }
  }
</style>

<script>
  const reduce = () => matchMedia("(prefers-reduced-motion: reduce)").matches;
  const wrap = (min: number, max: number, v: number) => {
    const r = max - min;
    return ((((v - min) % r) + r) % r) + min;
  };

  // ───────── Ticker: أقل عدد نسخ يملا الشاشة + سرعة بتهدى في الـ hover ─────────
  function ticker(fig: HTMLElement) {
    const box = fig.querySelector<HTMLElement>(".mu-ticker")!;
    const track = box.querySelector<HTMLElement>(".mu-track")!;
    const items = JSON.parse(box.dataset.ticker!) as string[];
    const slider = fig.querySelector<HTMLInputElement>("[data-velocity]")!;
    const out = slider.nextElementSibling as HTMLOutputElement;
    const info = fig.querySelector<HTMLElement>("[data-ticker-info]")!;
    const showClones = fig.querySelector<HTMLInputElement>("[data-show-clones]")!;

    const make = (text: string, clone: boolean) => {
      const el = document.createElement("span");
      el.className = "mu-tick";
      el.textContent = text;
      if (clone) el.setAttribute("aria-hidden", "true"); // قارئ الشاشة يقرا الأصل مرة واحدة بس
      return el;
    };
    for (const t of items) track.append(make(t, false));
    let setWidth = 0;

    function layout() {
      track.querySelectorAll('[aria-hidden="true"]').forEach((n) => n.remove());
      setWidth = track.scrollWidth;
      // محتاجين نسخ تكفي عرض الشاشة + مجموعة كاملة عشان اللفة متبانش
      const copies = Math.ceil(box.clientWidth / setWidth) + 1;
      for (let c = 0; c < copies - 1; c++) for (const t of items) track.append(make(t, true));
      info.textContent = `مجموعة واحدة = ${Math.round(setWidth)}px · الشاشة = ${box.clientWidth}px · نسخ = ${copies - 1}`;
    }
    layout();
    new ResizeObserver(layout).observe(box);

    if (reduce()) {
      box.classList.add("is-static"); // من غير حركة: شريط عادي تعمله scroll بإيدك
      return;
    }

    let x = 0;
    let factor = 1; // 1 عادي، 0.2 في الـ hover
    let target = 1;
    let factorVel = 0;
    let last = 0;
    let visible = true;
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(box);
    box.addEventListener("pointerenter", () => (target = 0.2));
    box.addEventListener("pointerleave", () => (target = 1));
    box.addEventListener("focusin", () => (target = 0));
    box.addEventListener("focusout", () => (target = 1));
    slider.addEventListener("input", () => (out.value = slider.value));
    showClones.addEventListener("change", () => box.classList.toggle("mu-show-clones", showClones.checked));

    function frame(now: number) {
      const dt = Math.min(0.05, last ? (now - last) / 1000 : 0);
      last = now;
      if (visible && setWidth) {
        // spring صغيرة على معامل السرعة، فالهدوء والرجوع ناعمين
        factorVel += (180 * (target - factor) - 26 * factorVel) * dt;
        factor += factorVel * dt;
        x = wrap(-setWidth, 0, x - Number(slider.value) * factor * dt);
        track.style.transform = `translateX(${x}px)`;
      }
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }

  // ───────── رقم بيتقلّب: Intl.NumberFormat + عمود لكل رقم ─────────
  function animateNumber(fig: HTMLElement) {
    const host = fig.querySelector<HTMLElement>("[data-number]")!;
    const localeBtn = fig.querySelector<HTMLButtonElement>("[data-locale]")!;
    let locale = "en-US";
    let value = 12480.5;
    let cols: HTMLElement[] = [];

    const digitsOf = (loc: string) => new Intl.NumberFormat(loc, { useGrouping: false }).format(1234567890).split("");
    const fmt = (loc: string) => new Intl.NumberFormat(loc, { style: "currency", currency: "USD", minimumFractionDigits: 2 });

    function render() {
      const digits = digitsOf(locale); // "1","2",…,"0" أو "١","٢",…,"٠"
      const order = [digits[9], ...digits.slice(0, 9)]; // 0 → 9
      const parts = fmt(locale).formatToParts(value);
      const chars: { ch: string; digit: boolean }[] = [];
      for (const p of parts) for (const ch of p.value) chars.push({ ch, digit: p.type === "integer" || p.type === "fraction" });
      host.setAttribute("aria-label", parts.map((p) => p.value).join(""));

      // بنربط الأعمدة من اليمين، فالآحاد تفضل الآحاد لما الرقم يكبر
      const next: HTMLElement[] = [];
      for (let i = chars.length - 1, k = cols.length - 1; i >= 0; i--, k--) {
        const { ch, digit } = chars[i];
        let col = k >= 0 ? cols[k] : undefined;
        if (!col || col.dataset.digit !== String(digit) || (digit && col.dataset.loc !== locale)) {
          col = document.createElement("span");
          col.className = digit ? "mu-col" : "mu-col mu-sym";
          col.dataset.digit = String(digit);
          col.dataset.loc = locale;
          col.setAttribute("aria-hidden", "true");
          const strip = document.createElement("span");
          if (digit) for (const d of order) strip.append(Object.assign(document.createElement("i"), { textContent: d }));
          col.append(strip);
          col.classList.add("is-new");
        }
        if (digit) (col.firstElementChild as HTMLElement).style.transform = `translateY(${-order.indexOf(ch)}em)`;
        else (col.firstElementChild as HTMLElement).textContent = ch;
        next.unshift(col);
      }
      host.replaceChildren(...next);
      cols = next;
    }
    render();
    fig.querySelectorAll<HTMLButtonElement>("[data-step]").forEach((b) =>
      b.addEventListener("click", () => {
        value = Math.max(0, value + Number(b.dataset.step));
        render();
      }),
    );
    fig.querySelector("[data-random]")!.addEventListener("click", () => {
      value = Math.round(Math.random() * 10 ** (2 + Math.floor(Math.random() * 6))) / 100;
      render();
    });
    localeBtn.addEventListener("click", () => {
      locale = locale === "en-US" ? "ar-EG" : "en-US";
      localeBtn.textContent = `اللغة: ${locale}`;
      cols = [];
      render();
    });
  }

  // ───────── Scramble: كل حرف بيتلخبط شوية وبعدين يثبت، من الشمال لليمين ─────────
  function scramble(fig: HTMLElement) {
    const el = fig.querySelector<HTMLElement>("[data-scramble]")!;
    const lines = ["Motion makes it feel alive", "Decode any string", "Build your own UI kit", "Small details, big feel"];
    const glyphs = "ABCDEFGHIJKLMNOPQRSTUVWXYZ#%&*+=?!<>/";
    let i = 0;
    let raf = 0;
    function go(to: string) {
      cancelAnimationFrame(raf);
      el.setAttribute("aria-label", to); // قارئ الشاشة يسمع الجملة النهائية بس
      if (reduce()) return void (el.textContent = to);
      const from = el.textContent ?? "";
      const len = Math.max(from.length, to.length);
      // كل حرف ليه وقت بداية ووقت ثبات، فالفك بيمشي زي موجة
      const plan = Array.from({ length: len }, (_, k) => ({ start: k * 18 + Math.random() * 120, end: 260 + k * 22 + Math.random() * 200 }));
      const t0 = performance.now();
      const tick = (now: number) => {
        const t = now - t0;
        let done = 0;
        const frag = document.createDocumentFragment();
        for (let k = 0; k < len; k++) {
          const p = plan[k];
          if (t >= p.end) {
            frag.append(to[k] ?? "");
            done++;
          } else if (t >= p.start && to[k] !== " ") {
            const s = document.createElement("span");
            s.className = "mu-glyph";
            s.textContent = glyphs[(Math.random() * glyphs.length) | 0];
            frag.append(s);
          } else frag.append(from[k] ?? "");
        }
        el.replaceChildren(frag);
        if (done < len) raf = requestAnimationFrame(tick);
      };
      raf = requestAnimationFrame(tick);
    }
    fig.querySelector("[data-next]")!.addEventListener("click", () => go(lines[(i = (i + 1) % lines.length)]));
  }

  // ───────── Typewriter: سرعة متغيرة + وقفة عند العلامات + Intl.Segmenter للحروف ─────────
  function typewriter(fig: HTMLElement) {
    const el = fig.querySelector<HTMLElement>("[data-type]")!;
    const caret = el.nextElementSibling as HTMLElement;
    const lines = ["أهلًا، أنا typewriter.", "بكتب حرف حرف، ووقفة عند الفاصلة، زي البني آدم.", "Unicode-safe: 👩🏽‍💻 ✓"];
    const seg = new Intl.Segmenter(undefined, { granularity: "grapheme" });
    const graphemes = (s: string) => Array.from(seg.segment(s), (x) => x.segment);
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    let visible = false;
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(fig);
    if (reduce()) return void (el.textContent = lines[0]);

    (async () => {
      for (let n = 0; ; n = (n + 1) % lines.length) {
        while (!visible) await sleep(300);
        const g = graphemes(lines[n]);
        caret.classList.add("is-typing");
        for (let k = 1; k <= g.length; k++) {
          el.textContent = g.slice(0, k).join("");
          const ch = g[k - 1];
          await sleep(/[،,.!؟?]/.test(ch) ? 320 : 35 + Math.random() * 70);
        }
        caret.classList.remove("is-typing");
        await sleep(1400);
        caret.classList.add("is-typing");
        for (let k = g.length; k >= 0; k--) {
          el.textContent = g.slice(0, k).join("");
          await sleep(18);
        }
        await sleep(300);
      }
    })();
  }

  // ───────── splitText: حروف ولا كلمات؟ ─────────
  function split(fig: HTMLElement) {
    const el = fig.querySelector<HTMLElement>("[data-split]")!;
    const note = fig.querySelector<HTMLElement>("[data-split-note]")!;
    const texts: Record<string, string> = {
      "en-chars": "Split me into letters",
      "ar-chars": "قطّعني حروف",
      "ar-words": "قطّعني كلمات بدل حروف",
    };
    const notes: Record<string, string> = {
      "en-chars": "الإنجليزي حروفه منفصلة أصلًا، فالتقطيع لحروف آمن.",
      "ar-chars": "شوف الحروف اتفكّت عن بعض: كل span بقى inline-block فالحرف فقد شكله الموصول.",
      "ar-words": "في العربي قطّع لكلمات، فكل كلمة تفضل حروفها لازقة في بعض.",
    };
    let mode = "en-chars";
    function render() {
      const text = texts[mode];
      const gran = mode === "ar-words" ? "word" : "grapheme";
      const seg = new Intl.Segmenter(mode.startsWith("ar") ? "ar" : "en", { granularity: gran });
      el.dir = mode.startsWith("ar") ? "rtl" : "ltr";
      el.setAttribute("aria-label", text);
      el.replaceChildren(
        ...Array.from(seg.segment(text), (s, i) => {
          const span = document.createElement("span");
          span.className = "mu-piece";
          span.setAttribute("aria-hidden", "true");
          span.style.setProperty("--i", String(i));
          span.textContent = s.segment;
          return span;
        }),
      );
      note.textContent = notes[mode];
    }
    render();
    fig.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach((b) =>
      b.addEventListener("click", () => {
        mode = b.dataset.mode!;
        fig.querySelectorAll("[data-mode]").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
        render();
      }),
    );
    fig.querySelector("[data-replay]")!.addEventListener("click", render);
  }

  // ───────── Cursor: spring بيتبع الماوس، ويتمغنط على الزراير، ويبقى خط فوق النص ─────────
  function cursor(fig: HTMLElement) {
    const area = fig.querySelector<HTMLElement>("[data-cursor-area]")!;
    const dot = area.querySelector<HTMLElement>(".mu-dot")!;
    // اللمس ملوش cursor، و reduced motion معناه نسيب الـ cursor بتاع النظام
    if (!matchMedia("(pointer: fine)").matches || reduce()) return;
    area.classList.add("is-live");

    const s = { x: 0, y: 0, w: 18, h: 18 };
    const v = { x: 0, y: 0, w: 0, h: 0 };
    const t = { x: 0, y: 0, w: 18, h: 18 };
    let running = false;
    let last = 0;

    function frame(now: number) {
      const dt = Math.min(1 / 30, (now - last) / 1000);
      last = now;
      let moving = false;
      for (const k of ["x", "y", "w", "h"] as const) {
        // spring أنشف شوية (420 / 32) عشان الـ cursor ميتأخرش، بخطوات صغيرة
        for (let i = 0; i < 4; i++) {
          v[k] += (420 * (t[k] - s[k]) - 32 * v[k]) * (dt / 4);
          s[k] += v[k] * (dt / 4);
        }
        if (Math.abs(t[k] - s[k]) > 0.1 || Math.abs(v[k]) > 0.1) moving = true;
      }
      dot.style.transform = `translate(${s.x - s.w / 2}px, ${s.y - s.h / 2}px)`;
      dot.style.width = `${s.w}px`;
      dot.style.height = `${s.h}px`;
      if (moving) requestAnimationFrame(frame);
      else running = false;
    }
    const kick = () => {
      if (running) return;
      running = true;
      last = performance.now();
      requestAnimationFrame(frame);
    };

    area.addEventListener("pointermove", (e) => {
      const r = area.getBoundingClientRect();
      const px = e.clientX - r.left;
      const py = e.clientY - r.top;
      const target = (e.target as HTMLElement).closest<HTMLElement>("[data-magnet]");
      const text = (e.target as HTMLElement).closest(".mu-cursor-text");
      dot.classList.toggle("is-text", !!text && !target);
      if (target) {
        // snap: الـ cursor ياخد شكل الزرار، ويتحرك معاك شوية بس (٢٠٪)
        const b = target.getBoundingClientRect();
        const cx = b.left - r.left + b.width / 2;
        const cy = b.top - r.top + b.height / 2;
        Object.assign(t, { x: cx + (px - cx) * 0.2, y: cy + (py - cy) * 0.2, w: b.width + 10, h: b.height + 10 });
        target.style.transform = `translate(${(px - cx) * 0.15}px, ${(py - cy) * 0.15}px)`;
      } else {
        Object.assign(t, text ? { x: px, y: py, w: 3, h: 24 } : { x: px, y: py, w: 18, h: 18 });
      }
      if (!dot.classList.contains("is-on")) {
        Object.assign(s, { x: t.x, y: t.y });
        dot.classList.add("is-on");
      }
      kick();
    });
    area.querySelectorAll<HTMLElement>("[data-magnet]").forEach((b) => {
      b.style.transition = "transform 0.35s var(--mu-back)";
      b.addEventListener("pointerleave", () => (b.style.transform = ""));
    });
    area.addEventListener("pointerleave", () => dot.classList.remove("is-on"));
  }

  // ───────── Curtains: ستارة تقفل، نبدّل الشاشة، الستارة تفتح ─────────
  function curtains(fig: HTMLElement) {
    const box = fig.querySelector<HTMLElement>("[data-screens]")!;
    const [a, b] = box.querySelectorAll<HTMLElement>(".mu-screen");
    let busy = false;

    function cover(kind: string) {
      const c = document.createElement("div");
      c.className = "mu-cover";
      const n = kind === "blinds" ? 6 : kind === "pixels" ? 48 : 1;
      if (kind === "blinds") c.style.gridTemplateColumns = `repeat(${n}, 1fr)`;
      if (kind === "pixels") c.style.gridTemplate = "repeat(6, 1fr) / repeat(8, 1fr)";
      for (let i = 0; i < n; i++) c.append(document.createElement("i"));
      box.append(c);
      return c;
    }
    // نفس الحركة رايح وجاي: in بتقفل الستارة، out بتفتحها
    function run(c: HTMLElement, kind: string, dir: "in" | "out") {
      const ease = dir === "in" ? "cubic-bezier(0.32, 0, 0.67, 0)" : "cubic-bezier(0.33, 1, 0.68, 1)";
      const pieces = [...c.children] as HTMLElement[];
      const anims = pieces.map((p, i) => {
        let frames: Keyframe[];
        let delay = 0;
        if (kind === "wipe") frames = [{ clipPath: "inset(0 0 0 100%)" }, { clipPath: "inset(0 0 0 0)" }];
        else if (kind === "iris") frames = [{ clipPath: "circle(0% at 50% 50%)" }, { clipPath: "circle(75% at 50% 50%)" }];
        else if (kind === "blinds") {
          frames = [{ transform: "scaleX(0)" }, { transform: "scaleX(1)" }];
          delay = i * 40;
        } else {
          frames = [{ opacity: 0 }, { opacity: 1 }];
          delay = Math.random() * 260;
        }
        if (dir === "out") frames.reverse();
        return p.animate(frames, { duration: kind === "pixels" ? 120 : 300, delay, easing: ease, fill: "both" }).finished;
      });
      return Promise.all(anims);
    }

    fig.querySelectorAll<HTMLButtonElement>("[data-curtain]").forEach((btn) =>
      btn.addEventListener("click", async () => {
        if (busy) return;
        const swap = () => {
          a.hidden = !a.hidden;
          b.hidden = !b.hidden;
        };
        if (reduce()) return swap();
        busy = true;
        const kind = btn.dataset.curtain!;
        const c = cover(kind);
        await run(c, kind, "in");
        swap();
        await run(c, kind, "out");
        c.remove();
        busy = false;
      }),
    );
  }

  const handlers: Record<string, (fig: HTMLElement) => void> = {
    ticker,
    number: animateNumber,
    scramble,
    typewriter,
    split,
    cursor,
    curtains,
  };
  const boot = () => {
    for (const fig of document.querySelectorAll<HTMLElement>("figure.mu[data-mu]")) {
      if (fig.dataset.bound) continue;
      fig.dataset.bound = "1";
      handlers[fig.dataset.mu!]?.(fig);
    }
  };
  boot();
  document.addEventListener("astro:page-load", boot);
</script>
